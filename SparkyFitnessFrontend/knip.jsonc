{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": ["src/main.tsx", "src/tests/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}"],
  "rules": {
    "exports": "error",
    "types": "off",
    "files": "error",
    "dependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
    "duplicates": "off",
  },
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "src/components/ui/**",
    // DG FIT hides these upstream features; their hooks stay for later merges.
    "src/hooks/useCycle.ts",
    "src/hooks/Fasting/useFasting.ts",
    "src/hooks/Settings/useFamilyAccess.ts",
    "src/hooks/useGeneralQueries.ts",
    "src/utils/languageUtils.ts",
    "src/pages/Diary/CaffeineCard.tsx",
  ],
}
